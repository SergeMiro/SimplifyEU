# =============================================================================
# SimplifyEU — root .env.example (Phase 7: Supabase -> plain Postgres)
# =============================================================================
# Copy to `.env` and fill in real values. The real `.env` is GITIGNORED — never
# commit secrets. These are NON-SECRET placeholders only.
#
# This file documents every variable the docker-compose*.yml service blocks
# now read after the migration. The web app (Next.js) is NOT in compose — it
# runs on Vercel and is configured via apps/web/.env.local / Vercel env (its
# vars are listed at the bottom for reference).
# =============================================================================

# ── General ──────────────────────────────────────────────────────────────────
ENVIRONMENT=production
# Comma-separated allowed origins for the Python services' CORS.
CORS_ORIGINS=https://simplify-eu.vercel.app,https://api.smiro.dev,https://agents.smiro.dev

# ── Postgres (NEW — replaces SUPABASE_URL/KEY/SERVICE_KEY) ────────────────────
# All four Python services connect with SQLAlchemy/psycopg via DATABASE_URL.
# Networking choice (Phase 7): containers reach the Supabase pooler (supavisor)
# through the Docker host gateway. Each service block declares:
#     extra_hosts: ["host.docker.internal:host-gateway"]
# so `host.docker.internal` resolves to the host, where the pooler publishes
# 0.0.0.0:5432 (session) and 0.0.0.0:6543 (transaction).
# The pooler requires a TENANT-QUALIFIED username: <role>.<POOLER_TENANT_ID>
#     => simplifyeu.hetzner-vps-tenant
# Form (session pooler, port 5432):
DATABASE_URL=postgresql://simplifyeu.hetzner-vps-tenant:CHANGE_ME_DB_PASSWORD@host.docker.internal:5432/simplifyeu_db
# Transaction-pooler alternative (port 6543): swap :5432 -> :6543 above.

# ── Better Auth JWT verification (NEW) ────────────────────────────────────────
# Public JWKS endpoint of the web app; services fetch it to verify Bearer JWTs.
# Must be reachable FROM the service containers at runtime (public URL or an
# in-network host the container can resolve).
BETTER_AUTH_JWKS_URL=https://simplify-eu.vercel.app/api/auth/jwks

# ── Service auth (NEW) ────────────────────────────────────────────────────────
# Shared key the web app sends as X-API-Key. MUST match the web side, or in
# ENVIRONMENT=production every service call returns 403 (test-key bypass off).
SERVICE_API_KEY=CHANGE_ME_SHARED_SERVICE_KEY

# ── LLM providers (existing — leave as used per service) ──────────────────────
# subscription-analyzer / crewai-agents
OPENAI_API_KEY=CHANGE_ME_LLM_KEY
OPENAI_BASE_URL=https://llm.chutes.ai/v1
LLM_PROVIDER=openai
LLM_MODEL=chutesai/Mistral-Small-3.1-24B-Instruct-2503
MISTRAL_API_KEY=CHANGE_ME_MISTRAL_KEY
CHUTES_API_KEY=CHANGE_ME_CHUTES_KEY
CHUTES_BASE_URL=https://llm.chutes.ai/v1

# ── Redis (existing) ─────────────────────────────────────────────────────────
# docker-compose.yml / production.yml default to an in-stack redis service.
REDIS_URL=redis://redis:6379/0

# ── Security / misc (existing) ───────────────────────────────────────────────
API_KEY_SALT=CHANGE_ME_API_KEY_SALT
GUNICORN_WORKERS=4

# ── SMTP (existing — subscription-analyzer / crewai-agents) ──────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME_SMTP_USER
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_SENDER_EMAIL=noreply@simplifyeu.com
SMTP_SENDER_NAME=SimplifyEU Reports

# ── Slack (existing — team-reminder-bot) ─────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-placeholder
SLACK_SIGNING_SECRET=placeholder

# ── Twilio / WhatsApp (existing — crewai-agents) ─────────────────────────────
TWILIO_ACCOUNT_SID=CHANGE_ME_TWILIO_SID
TWILIO_AUTH_TOKEN=CHANGE_ME_TWILIO_TOKEN
TWILIO_WHATSAPP_FROM=whatsapp:+10000000000

# =============================================================================
# Web app (NOT in docker-compose) — apps/web/.env.local or Vercel env.
# Listed here only for reference; the web is deployed on Vercel.
#   DATABASE_URL=postgresql://simplifyeu.hetzner-vps-tenant:PASSWORD@HOST:5432/simplifyeu_db
#   BETTER_AUTH_URL=https://simplify-eu.vercel.app
#   BETTER_AUTH_SECRET=CHANGE_ME_BETTER_AUTH_SECRET
#   NEXT_PUBLIC_BETTER_AUTH_URL=https://simplify-eu.vercel.app
# =============================================================================
