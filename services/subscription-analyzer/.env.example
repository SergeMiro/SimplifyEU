ENVIRONMENT=development

# Database (plain Postgres via SQLAlchemy). Standard libpq URL; the app forces
# the psycopg (v3) driver internally.
DATABASE_URL=postgresql://user:password@localhost:5432/simplifyeu_db

# Auth
# Better Auth JWKS endpoint on the web app (public keys to verify the Bearer JWT).
BETTER_AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
JWKS_CACHE_SECONDS=300
# Shared service key the web app sends in the X-API-Key header.
SERVICE_API_KEY=your-service-api-key-here

# Local file storage for uploaded statements and generated reports
UPLOAD_DIR=/tmp/subscription-uploads
REPORTS_DIR=/tmp/subscription-reports

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM Providers
MISTRAL_API_KEY=your_mistral_api_key
CHUTES_API_KEY=your_chutes_api_key
LLM_PROVIDER=mistral
CHUTES_MODEL=glm-4.7

# Redis (for caching and rate limiting)
REDIS_URL=redis://redis:6379/0

# SMTP Configuration for Email Reports
# For Gmail: smtp.gmail.com, port 587, use App Password
# For SendGrid: smtp.sendgrid.net, port 587, API key as password
# For Mailgun: smtp.mailgun.org, port 587
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user@example.com
SMTP_PASSWORD=your_smtp_password
SMTP_SENDER_EMAIL=noreply@simplifyeu.com
SMTP_SENDER_NAME=SimplifyEU Reports
SMTP_USE_TLS=true
SMTP_USE_SSL=false
