# Environment
ENVIRONMENT=development

# Database (plain Postgres via SQLAlchemy). Standard libpq URL; the app forces
# the psycopg (v3) driver internally.
DATABASE_URL=postgresql://user:password@localhost:5432/simplifyeu_db

# Auth
# Better Auth JWKS endpoint on the web app (public keys to verify the Bearer JWT).
BETTER_AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
JWKS_CACHE_SECONDS=300
# Shared service key the web app sends in the X-API-Key header.
SERVICE_API_KEY=your-service-api-key-here

# LLM Provider (required for agent intelligence)
OPENAI_API_KEY=your-openai-api-key
# or
MISTRAL_API_KEY=your-mistral-api-key
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# WhatsApp / Twilio (optional — for WhatsApp notifications)
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=+14155238886

# SMTP (optional — for email notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user@example.com
SMTP_PASSWORD=your_smtp_password
SMTP_SENDER_EMAIL=noreply@simplifyeu.com

# Redis (optional — for caching)
REDIS_URL=redis://localhost:6379

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Agent Defaults
WEEKLY_REPORT_DAY=monday
WEEKLY_REPORT_HOUR=8
TAX_REMINDER_DAYS_BEFORE=5
