# Invoice Duplicate Detector - Environment Variables
ENVIRONMENT=development

# Database (plain Postgres via SQLAlchemy). Standard libpq URL; the app forces
# the psycopg (v3) driver internally.
DATABASE_URL=postgresql://user:password@localhost:5432/simplifyeu_db

# Auth
# Better Auth JWKS endpoint on the web app (public keys to verify the Bearer JWT).
BETTER_AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
JWKS_CACHE_SECONDS=300
# Shared service key the web app sends in the X-API-Key header.
SERVICE_API_KEY=your-service-api-key-here

# File Upload
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.tiff
UPLOAD_DIR=/tmp/invoice-uploads

# OCR
OCR_ENABLED=true
OCR_LANGUAGE=eng+fra
OCR_RETRY_MAX=3
OCR_RETRY_BACKOFF_BASE=2.0

# Fuzzy Matching Weights
WEIGHT_INVOICE_NUMBER=0.30
WEIGHT_AMOUNT=0.25
WEIGHT_DATE=0.15
WEIGHT_VENDOR=0.20
WEIGHT_LINE_ITEMS=0.10
DUPLICATE_THRESHOLD=0.85

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
