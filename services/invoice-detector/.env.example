# Invoice Duplicate Detector - Environment Variables
ENVIRONMENT=development

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# File Upload
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.tiff
UPLOAD_DIR=/tmp/invoice-uploads

# OCR
OCR_ENABLED=true
OCR_LANGUAGE=eng+fra
OCR_RETRY_MAX=3
OCR_RETRY_BACKOFF_BASE=2.0

# Fuzzy Matching Weights
WEIGHT_INVOICE_NUMBER=0.30
WEIGHT_AMOUNT=0.25
WEIGHT_DATE=0.15
WEIGHT_VENDOR=0.20
WEIGHT_LINE_ITEMS=0.10
DUPLICATE_THRESHOLD=0.85

# Security
API_KEY_SALT=your-api-key-salt-here

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
